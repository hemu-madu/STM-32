#include "stm32l476xx.h"
#include "rcc.h"
#include "gpio.h"
#include "uart.h"
#include "spi.h"
#include "i2c.h"
#include "sdcard.h"
#include "ff.h"
#include "bme280.h"
#include "rtc.h"
#include <stdio.h>
#include <string.h>

#define SAMPLE_COUNT  10

FATFS fs;
FIL file;
UINT bw, br;

char buffer[256];

void delay_ms(uint32_t ms)
{
    for(uint32_t i=0;i<ms*4000;i++);
}

int main(void)
{
    RCC_Init();
    GPIO_Init();
    UART2_Init();
    SPI1_Init();
    I2C1_Init();
    RTC_Init();
    BME280_Init();

    FRESULT res;

    res = f_mount(&fs, "", 1);

    if(res == FR_OK)
    {
        UART2_Print("Mount OK\r\n");
    }
    else
    {
        printf("Mount Failed: %d\r\n", res);
        while(1);
    }
}
