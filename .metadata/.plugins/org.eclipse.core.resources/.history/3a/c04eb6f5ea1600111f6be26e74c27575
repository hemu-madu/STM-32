#include "stm32l476xx.h"
#include "rcc.h"
#include "gpio.h"
#include "uart.h"
#include "spi.h"
#include "i2c.h"
#include "sdcard.h"
#include "ff.h"
#include "bme280.h"
#include "rtc.h"
#include <stdio.h>
#include <string.h>

#define SAMPLE_COUNT 12

FATFS fs;
FIL file;
UINT bw, br;

char read_buffer[256];

void delay_ms(uint32_t ms)
{
    for(uint32_t i=0;i<ms*4000;i++);
}

int main(void)
{
    RCC_Init();
    GPIO_Init();
    UART2_Init();
    SPI1_Init();

    UART2_Print("System Ready\r\n");

    FRESULT res;

    /* ===== Mount SD ===== */
    res = f_mount(&fs, "", 1);

    if(res != FR_OK)
    {
        char msg[40];
        sprintf(msg, "Mount Failed: %d\r\n", res);
        UART2_Print(msg);
        while(1);
    }

    UART2_Print("Mount OK\r\n");

    /* ===== Create or Open File ===== */
    res = f_open(&file, "temp_file.txt",
                 FA_OPEN_ALWAYS | FA_WRITE);

    if(res != FR_OK)
    {
        char msg[40];
        sprintf(msg, "File Open Failed: %d\r\n", res);
        UART2_Print(msg);
        while(1);
    }

    UART2_Print("File Open Success\r\n");

    /* Move to end (append mode) */
    f_lseek(&file, f_size(&file));

    /* ===== Write Data ===== */
    char data[] = "SD Test Line\r\n";

    res = f_write(&file, data, strlen(data), &bw);

    if(res == FR_OK && bw == strlen(data))
    {
        UART2_Print("Write Success\r\n");
    }
    else
    {
        UART2_Print("Write Failed\r\n");
    }

    /* Force sync to SD */
    f_sync(&file);

    /* Close file */
    f_close(&file);

    UART2_Print("File Closed\r\n");

    /* ===== Reopen and Read File ===== */
    res = f_open(&file, "temp_file.txt", FA_READ);

    if(res != FR_OK)
    {
        char msg[40];
        sprintf(msg, "Read Open Failed: %d\r\n", res);
        UART2_Print(msg);
        while(1);
    }

    UART2_Print("\r\n--- FILE CONTENT ---\r\n");

    while(1)
    {
        res = f_read(&file, read_buffer,
                     sizeof(read_buffer)-1, &br);

        if(res != FR_OK || br == 0)
            break;

        read_buffer[br] = 0;
        UART2_Print(read_buffer);
    }

    f_close(&file);

    UART2_Print("\r\n--------------------\r\n");

    while(1);
}
