#include "stm32l476xx.h"

void UART2_Init(void);
void UART2_Write(char ch);
void UART2_Print(char *str);
void I2C1_Init(void);
void I2C1_Write(uint8_t addr, uint8_t data);

int main(void)
{
    UART2_Init();
    I2C1_Init();

    UART2_Print("I2C BareMetal Test\r\n");

    while(1)
    {
        I2C1_Write(0x50, 0xAA);   // Send to slave 0x50
        UART2_Print("Data Sent\r\n");

        for(volatile int i=0;i<1000000;i++);
    }
}

/* ================= UART ================= */

void UART2_Init(void)
{
    RCC->AHB2ENR |= RCC_AHB2ENR_GPIOAEN;
    RCC->APB1ENR1 |= RCC_APB1ENR1_USART2EN;

    GPIOA->MODER &= ~(3<<(2*2));
    GPIOA->MODER |=  (2<<(2*2));
    GPIOA->AFR[0] |= (7<<(4*2));

    USART2->BRR = 0x1A1;   // 9600 @16MHz
    USART2->CR1 |= USART_CR1_TE;
    USART2->CR1 |= USART_CR1_UE;
}

void UART2_Write(char ch)
{
    while(!(USART2->ISR & USART_ISR_TXE));
    USART2->TDR = ch;
}

void UART2_Print(char *str)
{
    while(*str)
    {
        UART2_Write(*str++);
    }
}

/* ================= I2C ================= */

void I2C1_Init(void)
{
    RCC->AHB2ENR |= RCC_AHB2ENR_GPIOBEN;
    RCC->APB1ENR1 |= RCC_APB1ENR1_I2C1EN;

    // PB6 SCL, PB7 SDA
    GPIOB->MODER &= ~(0xF << (6*2));
    GPIOB->MODER |=  (0xA << (6*2));  // AF mode

    GPIOB->OTYPER |= (1<<6) | (1<<7); // Open Drain
    GPIOB->OSPEEDR |= (3<<(6*2)) | (3<<(7*2));
    GPIOB->PUPDR |= (1<<(6*2)) | (1<<(7*2));

    GPIOB->AFR[0] |= (4<<(4*6)) | (4<<(4*7));

    I2C1->CR1 &= ~I2C_CR1_PE;

    I2C1->TIMINGR = 0x00303D5B;   // 100kHz @16MHz

    I2C1->CR1 |= I2C_CR1_PE;
}

void I2C1_Write(uint8_t addr, uint8_t data)
{
    I2C1->CR2 = 0;  // Clear previous settings

    I2C1->CR2 |= (addr << 1);     // Slave address
    I2C1->CR2 |= (1 << 16);       // NBYTES = 1
    I2C1->CR2 |= I2C_CR2_START;   // Generate START

    // Wait until TXIS or NACK
    while(1)
    {
        if(I2C1->ISR & I2C_ISR_TXIS)
            break;

        if(I2C1->ISR & I2C_ISR_NACKF)
        {
            I2C1->ICR |= I2C_ICR_NACKCF;  // Clear NACK
            I2C1->CR2 |= I2C_CR2_STOP;    // Generate STOP
            return;  // Exit safely
        }
    }

    I2C1->TXDR = data;

    while(!(I2C1->ISR & I2C_ISR_TC));

    I2C1->CR2 |= I2C_CR2_STOP;
}
