#include "logger.h"
#include "ff.h"
#include "uart.h"
#include <stdio.h>
#include <string.h>

static FATFS fs;
static FIL file;

void Logger_Init(void)
{
    if(f_mount(&fs, "", 1) != FR_OK)
    {
        UART2_Print("SD Mount Failed!\r\n");
        while(1);
    }

    UART2_Print("SD Mount OK\r\n");
}

void Logger_LogTemperature(float temp)
{
    char buffer[64];
    UINT bw;

    sprintf(buffer, "Temp: %.2f C\r\n", temp);

    if(f_open(&file, "temp_log.txt", FA_OPEN_APPEND | FA_WRITE) == FR_OK)
    {
        f_write(&file, buffer, strlen(buffer), &bw);
        f_close(&file);
    }
}

void Logger_PrintFile(void)
{
    char readbuf[64];
    UINT br;

    if(f_open(&file, "temp_log.txt", FA_READ) != FR_OK)
    {
        UART2_Print("File Open Error\r\n");
        return;
    }

    UART2_Print("\r\n--- FILE DATA ---\r\n");

    while(1)
    {
        if(f_read(&file, readbuf, sizeof(readbuf)-1, &br) != FR_OK || br == 0)
            break;

        readbuf[br] = '\0';
        UART2_Print(readbuf);
    }

    UART2_Print("\r\n--- END ---\r\n");

    f_close(&file);
}
