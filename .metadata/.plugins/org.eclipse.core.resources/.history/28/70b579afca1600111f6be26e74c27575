#include "stm32l476xx.h"
#include "rcc.h"
#include "gpio.h"
#include "uart.h"
#include "spi.h"
#include "i2c.h"
#include "sdcard.h"
#include "ff.h"
#include "bme280.h"
#include "rtc.h"
#include <stdio.h>
#include <string.h>

#define SAMPLE_COUNT 12

FATFS fs;
FIL file;
UINT bw, br;

char read_buffer[256];

void delay_ms(uint32_t ms)
{
    for(uint32_t i=0;i<ms*4000;i++);
}

int main(void)
{
    RCC_Init();
    GPIO_Init();
    UART2_Init();
    SPI1_Init();
    I2C1_Init();
    RTC_Init();
    BME280_Init();

    UART2_Print("System Ready\r\n");

    if(f_mount(&fs, "", 1) != FR_OK)
    {
        UART2_Print("Mount Failed\r\n");
        while(1);
    }

    UART2_Print("Mount OK\r\n");

    float temp_buffer[SAMPLE_COUNT];
    uint8_t index = 0;

    while(1)
    {
        /* ===== Fast Sampling ===== */
        temp_buffer[index++] = BME280_ReadTemperature();
        delay_ms(300);

        /* ===== When Buffer Full ===== */
        if(index >= SAMPLE_COUNT)
        {
            if(f_open(&file, "temp_logs.txt",
                      FA_OPEN_APPEND | FA_WRITE) == FR_OK)
            {
                for(uint8_t i=0;i<SAMPLE_COUNT;i++)
                {
                    uint8_t h,m,s,d,mo,y;
                    RTC_Get_Time(&h,&m,&s);
                    RTC_Get_Date(&d,&mo,&y);

                    char line[64];

                    sprintf(line,
                            "%02d-%02d-20%02d %02d:%02d:%02d  %.2f C\r\n",
                            d,mo,y,h,m,s,temp_buffer[i]);

                    f_write(&file, line, strlen(line), &bw);
                }

                f_close(&file);
            }

            index = 0;
        }

        /* ===== Button Press -> Print File ===== */
        if(Button_Pressed())
        {
            delay_ms(200);

            if(Button_Pressed())
            {
                UART2_Print("\r\n--- LOG DATA ---\r\n");

                if(f_open(&file, "temp_logs.txt", FA_READ) == FR_OK)
                {
                    while(1)
                    {
                        if(f_read(&file, read_buffer,
                                  sizeof(read_buffer)-1, &br) != FR_OK || br == 0)
                            break;

                        read_buffer[br] = 0;
                        UART2_Print(read_buffer);
                    }

                    f_close(&file);
                }

                UART2_Print("\r\n----------------\r\n");

                while(Button_Pressed());
            }
        }
    }
}
