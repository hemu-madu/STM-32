#include "stm32l476xx.h"
#include "rcc.h"
#include "gpio.h"
#include "uart.h"
#include "spi.h"
#include "sdcard.h"
#include "ff.h"
#include <stdio.h>
#include <string.h>

FATFS fs;
FIL file;
UINT bw, br;
char buffer[128];

void delay_ms(uint32_t ms)
{
    for(uint32_t i=0;i<ms*4000;i++);
}

int main(void)
{
    RCC_Init();
    GPIO_Init();
    UART2_Init();
    SPI1_Init();

    UART2_Print("Starting...\r\n");

    /* Mount SD */
    if(f_mount(&fs, "", 1) != FR_OK)
    {
        UART2_Print("Mount Failed\r\n");
        while(1);
    }

    UART2_Print("Mount OK\r\n");

    /* Create and Write File */
    if(f_open(&file, "test.txt", FA_CREATE_ALWAYS | FA_WRITE) == FR_OK)
    {
        char data[] = "Line 1\r\nLine 2\r\nLine 3\r\n";

        f_write(&file, data, strlen(data), &bw);
        f_close(&file);

        UART2_Print("File Written\r\n");
    }

    while(1)
    {
        /* If Blue Button Pressed */
        if(Button_Pressed())
        {
            delay_ms(200);   // debounce

            if(Button_Pressed())
            {
                UART2_Print("\r\n--- FILE CONTENT ---\r\n");

                if(f_open(&file, "test.txt", FA_READ) == FR_OK)
                {
                    while(1)
                    {
                        if(f_read(&file, buffer, sizeof(buffer)-1, &br) != FR_OK || br == 0)
                            break;

                        buffer[br] = 0;
                        UART2_Print(buffer);
                    }

                    f_close(&file);
                }
                else
                {
                    UART2_Print("File Open Failed\r\n");
                }

                UART2_Print("\r\n--------------------\r\n");

                /* Wait until button released */
                while(Button_Pressed());
            }
        }
    }
}
