#include "ff_gen_drv.h"
#include "sd_spi.h"
#include <string.h>

/* Disk status */
static volatile DSTATUS Stat = STA_NOINIT;

/* Function prototypes */
DSTATUS USER_initialize (BYTE pdrv);
DSTATUS USER_status (BYTE pdrv);
DRESULT USER_read (BYTE pdrv, BYTE *buff, DWORD sector, UINT count);
#if _USE_WRITE == 1
DRESULT USER_write (BYTE pdrv, const BYTE *buff, DWORD sector, UINT count);
#endif
#if _USE_IOCTL == 1
DRESULT USER_ioctl (BYTE pdrv, BYTE cmd, void *buff);
#endif

/* Driver structure */
Diskio_drvTypeDef USER_Driver =
{
    USER_initialize,
    USER_status,
    USER_read,
#if  _USE_WRITE == 1
    USER_write,
#endif
#if  _USE_IOCTL == 1
    USER_ioctl,
#endif
};

/*-----------------------------------------------------------------------*/
/* Initialize Disk Drive                                                 */
/*-----------------------------------------------------------------------*/
DSTATUS USER_initialize (BYTE pdrv)
{
    if (pdrv != 0)
        return STA_NOINIT;

    if (SD_Init() == 0)
        Stat = 0;
    else
        Stat = STA_NOINIT;

    return Stat;
}

/*-----------------------------------------------------------------------*/
DSTATUS USER_status (BYTE pdrv)
{
    if (pdrv != 0)
        return STA_NOINIT;

    return Stat;
}

/*-----------------------------------------------------------------------*/
DRESULT USER_read (
    BYTE pdrv,
    BYTE *buff,
    DWORD sector,
    UINT count
)
{
    if (pdrv != 0 || !count)
        return RES_PARERR;

    if (Stat & STA_NOINIT)
        return RES_NOTRDY;

    for (UINT i = 0; i < count; i++)
    {
        if (SD_ReadBlock(buff + (512 * i), sector + i) != 0)
            return RES_ERROR;
    }

    return RES_OK;
}

/*-----------------------------------------------------------------------*/
#if _USE_WRITE == 1
DRESULT USER_write (
    BYTE pdrv,
    const BYTE *buff,
    DWORD sector,
    UINT count
)
{
    return RES_OK;   // Temporary disable write
}
#endif
/*-----------------------------------------------------------------------*/
#if _USE_IOCTL == 1
DRESULT USER_ioctl (
    BYTE pdrv,
    BYTE cmd,
    void *buff
)
{
    if (pdrv != 0)
        return RES_PARERR;

    switch (cmd)
    {
        case CTRL_SYNC:
            return RES_OK;

        case GET_SECTOR_COUNT:
            *(DWORD*)buff = 32768;
            return RES_OK;

        case GET_SECTOR_SIZE:
            *(WORD*)buff = 512;
            return RES_OK;

        case GET_BLOCK_SIZE:
            *(DWORD*)buff = 1;
            return RES_OK;

        default:
            return RES_PARERR;
    }
}
#endif
