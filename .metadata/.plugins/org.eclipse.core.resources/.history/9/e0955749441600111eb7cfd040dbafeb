#include "stm32l476xx.h"
#include "spi.h"
#include "uart.h"
#include "sdcard.h"
#include "ff.h"
#include "bme280.h"
#include "rtc.h"
#include "gpio.h"
#include <stdio.h>
#include <string.h>

/* FATFS objects */
FATFS fs;
FIL file;
UINT bw, br;

/* Buffer */
char buffer[256];

/* Simple delay */
void delay_ms(uint32_t ms)
{
    for(uint32_t i = 0; i < ms * 4000; i++);
}

/* Button pressed check (PC13 - active LOW) */
uint8_t Button_Pressed(void)
{
    return ((GPIOC->IDR & (1 << 13)) == 0);
}

int main(void)
{
    /* Basic init */
    SystemClock_Config();   // Your clock config
    GPIO_Init();            // Must enable pull-up for PC13
    UART2_Init();
    SPI1_Init();
    RTC_Init();
    BME280_Init();

    UART2_Print("\r\n==== TEMPERATURE LOGGER STARTED ====\r\n");

    /* Mount SD card */
    if(f_mount(&fs, "", 1) != FR_OK)
    {
        UART2_Print("SD Mount Failed!\r\n");
        while(1);
    }

    UART2_Print("SD Mounted Successfully\r\n");

    while(1)
    {
        /* ======== 1️⃣ Read Temperature ======== */
        float temperature = BME280_Read_Temperature();

        /* ======== 2️⃣ Read RTC Time ======== */
        uint8_t hour, min, sec;
        uint8_t date, month, year;

        RTC_Get_Time(&hour, &min, &sec);
        RTC_Get_Date(&date, &month, &year);

        /* ======== 3️⃣ Prepare Log Line ======== */
        char logline[128];

        sprintf(logline,
                "%02d-%02d-20%02d %02d:%02d:%02d  Temp: %.2f C\r\n",
                date, month, year,
                hour, min, sec,
                temperature);

        /* ======== 4️⃣ Write to SD (Append Mode) ======== */
        if(f_open(&file, "temperature_logs.txt", FA_OPEN_APPEND | FA_WRITE) == FR_OK)
        {
            f_write(&file, logline, strlen(logline), &bw);
            f_close(&file);
        }
        else
        {
            UART2_Print("File Open Failed!\r\n");
        }

        UART2_Print("Logged: ");
        UART2_Print(logline);

        /* ======== 5️⃣ Button Press → Print File ======== */
        if(Button_Pressed())
        {
            delay_ms(200);   // debounce

            if(Button_Pressed())
            {
                UART2_Print("\r\n----- FILE CONTENT START -----\r\n");

                if(f_open(&file, "temperature_logs.txt", FA_READ) == FR_OK)
                {
                    while(1)
                    {
                        if(f_read(&file, buffer, sizeof(buffer)-1, &br) != FR_OK || br == 0)
                            break;

                        buffer[br] = 0;
                        UART2_Print(buffer);
                    }

                    f_close(&file);
                }
                else
                {
                    UART2_Print("File Read Failed!\r\n");
                }

                UART2_Print("\r\n----- FILE CONTENT END -----\r\n");

                /* Wait until button released */
                while(Button_Pressed());
            }
        }

        delay_ms(5000);   // Log every 5 seconds
    }
}
