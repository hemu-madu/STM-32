#include "main.h"

extern SPI_HandleTypeDef hspi1;

#define SD_CS_LOW()   HAL_GPIO_WritePin(GPIOA, GPIO_PIN_4, GPIO_PIN_RESET)
#define SD_CS_HIGH()  HAL_GPIO_WritePin(GPIOA, GPIO_PIN_4, GPIO_PIN_SET)

uint8_t SPI_TxRx(uint8_t data)
{
    uint8_t rx;
    HAL_SPI_TransmitReceive(&hspi1, &data, &rx, 1, HAL_MAX_DELAY);
    return rx;
}

void SD_SendClock(void)
{
    for(int i=0;i<10;i++)
        SPI_TxRx(0xFF);
}

uint8_t SD_SendCmd(uint8_t cmd, uint32_t arg, uint8_t crc)
{
    uint8_t response;
    uint8_t frame[6];

    frame[0] = cmd | 0x40;
    frame[1] = arg >> 24;
    frame[2] = arg >> 16;
    frame[3] = arg >> 8;
    frame[4] = arg;
    frame[5] = crc;

    SD_CS_LOW();

    for(int i=0;i<6;i++)
        SPI_TxRx(frame[i]);

    for(int i=0;i<10;i++)
    {
        response = SPI_TxRx(0xFF);
        if(!(response & 0x80))
            break;
    }

    return response;
}

uint8_t SD_Init(void)
{
    uint8_t response;
    uint16_t retry = 0;

    SD_CS_HIGH();
    SD_SendClock();

    SD_CS_LOW();

    response = SD_SendCmd(0, 0, 0x95);  // CMD0
    if(response != 0x01)
        return 1;

    response = SD_SendCmd(8, 0x1AA, 0x87);  // CMD8
    if(response != 0x01)
        return 2;

    SPI_TxRx(0xFF); SPI_TxRx(0xFF);
    SPI_TxRx(0xFF); SPI_TxRx(0xFF);

    do
    {
        SD_SendCmd(55, 0, 0x01);
        response = SD_SendCmd(41, 0x40000000, 0x01);
        retry++;
    } while(response != 0x00 && retry < 1000);

    SD_CS_HIGH();
    // Increase SPI speed after init
    hspi1.Init.BaudRatePrescaler = SPI_BAUDRATEPRESCALER_8;
    HAL_SPI_Init(&hspi1);
    if(retry >= 1000)
        return 3;

    return 0;
}

uint8_t SD_ReadBlock(uint8_t *buffer, uint32_t sector)
{
    uint8_t token;
    uint16_t timeout = 0;

    SD_CS_LOW();

    // Send CMD17
    if (SD_SendCmd(17, sector, 0x01) != 0x00)
    {
        SD_CS_HIGH();
        SPI_TxRx(0xFF);
        return 1;
    }

    // Give one extra clock
    SPI_TxRx(0xFF);

    // Wait for data token (0xFE)
    do
    {
        token = SPI_TxRx(0xFF);
        timeout++;
        if (timeout > 20000)
        {
            SD_CS_HIGH();
            SPI_TxRx(0xFF);
            return 2;
        }
    } while (token != 0xFE);

    // Read 512 bytes
    for (int i = 0; i < 512; i++)
    {
        buffer[i] = SPI_TxRx(0xFF);
    }

    // Read CRC
    SPI_TxRx(0xFF);
    SPI_TxRx(0xFF);

    SD_CS_HIGH();
    SPI_TxRx(0xFF);

    return 0;
}
uint8_t SD_WriteBlock(uint8_t *buffer, uint32_t sector)
{
    SD_CS_LOW();

    if(SD_SendCmd(24, sector, 0x01) != 0x00)
    {
        SD_CS_HIGH();
        return 1;
    }

    SPI_TxRx(0xFE);

    for(int i=0;i<512;i++)
        SPI_TxRx(buffer[i]);

    SPI_TxRx(0xFF);
    SPI_TxRx(0xFF);

    uint8_t response = SPI_TxRx(0xFF);

    SD_CS_HIGH();

    if((response & 0x1F) != 0x05)
        return 2;

    return 0;
}

