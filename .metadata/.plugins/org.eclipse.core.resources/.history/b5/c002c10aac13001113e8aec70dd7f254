int __io_putchar(int ch)
{
  HAL_UART_Transmit(&huart2, (uint8_t *)&ch, 1, HAL_MAX_DELAY);
  return ch;
}
/* USER CODE END 0 */
int main(void)
{
	printf("Mounting...\r\n");

	FATFS fs;
	FIL fil;
	FRESULT fres;
	UINT bw;

	fres = f_mount(&fs, "", 1);

	if (fres != FR_OK)
	{
	    printf("Mount Failed: %d\r\n", fres);
	}
	else
	{
	    printf("Mount OK\r\n");

	    fres = f_open(&fil, "log.txt", FA_OPEN_ALWAYS | FA_WRITE);

	    if (fres == FR_OK)
	    {
	        printf("File Opened\r\n");

	        f_lseek(&fil, f_size(&fil));

	        char data[] = "STM32 Log Entry\r\n";

	        f_write(&fil, data, sizeof(data)-1, &bw);
	        f_sync(&fil);
	        f_close(&fil);

	        printf("File Written & Closed\r\n");
	    }
	    else
	    {
	        printf("File Error: %d\r\n", fres);
	    }
	}
	while(1)
	{
	    HAL_Delay(2000);
	}
}
