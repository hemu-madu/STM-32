extern osSemaphoreId myCountingSemHandle;
/* USER CODE END Variables */

/* Producer Task: signals (gives) the semaphore */
void ProducerTask_func(void const * argument)
{
  uint8_t count = 0;

  for(;;)
  {
    /* Simulate producing an item */
    osDelay(1000);  // produce every 1 second

    if(osSemaphoreRelease(myCountingSemHandle) == osOK)
    {
      count++;
      printf("[Producer] Item produced. Semaphore count signal sent. Total: %d\r\n", count);
    }
    else
    {
      printf("[Producer] Semaphore full! Cannot release.\r\n");
    }
  }
}

/* Consumer Task: waits (takes) the semaphore */
void ConsumerTask_func(void const * argument)
{
  uint8_t consumed = 0;

  for(;;)
  {
    /* Wait indefinitely for a semaphore token */
    if(osSemaphoreWait(myCountingSemHandle, osWaitForever) == osOK)
    {
      consumed++;
      printf("[Consumer] Item consumed. Count: %d\r\n", consumed);

      /* Simulate processing time */
      osDelay(2000);
    }
  }
}

