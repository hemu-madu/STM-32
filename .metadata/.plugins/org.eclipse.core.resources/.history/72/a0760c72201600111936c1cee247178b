#include "sdcard.h"
#include "spi.h"
#include "uart.h"
#include <stdio.h>

#define CMD0    0
#define CMD8    8
#define CMD17   17
#define CMD24   24
#define CMD55   55
#define CMD41   41
#define CMD58   58
#define CMD16 16

uint8_t SDHC_FLAG = 0;

/* ============================================================ */
/* Send 80 dummy clock pulses (CS HIGH)                        */
/* ============================================================ */
void SD_SendClockTrain(void)
{
    SD_CS_HIGH();

    for(int i = 0; i < 10; i++)   // 10 × 8 = 80 clocks
        SPI1_Transfer(0xFF);
}


/* ============================================================ */
/* Send Command (CS must already be LOW before calling)        */
/* ============================================================ */
uint8_t SD_SendCommand(uint8_t cmd, uint32_t arg, uint8_t crc)
{
    uint8_t response;
    uint32_t timeout = 0xFFFF;

    SPI1_Transfer(0x40 | cmd);
    SPI1_Transfer(arg >> 24);
    SPI1_Transfer(arg >> 16);
    SPI1_Transfer(arg >> 8);
    SPI1_Transfer(arg);
    SPI1_Transfer(crc);
//    SPI1_Transfer(0xFF);

    do {
        response = SPI1_Transfer(0xFF);
        timeout--;
    } while((response & 0x80) && timeout);

    return response;
}

/* ============================================================ */
/* SD Initialization                                            */
/* ============================================================ */
uint8_t SD_Init(void)
{
    uint8_t response;
    uint32_t ocr;

    SD_CS_HIGH();

    // Send at least 80 clocks
    for(int i = 0; i < 10; i++)
        SPI1_Transfer(0xFF);

    SD_CS_LOW();

    // Extra dummy
    SPI1_Transfer(0xFF);

    /* CMD0 */
    response = SD_SendCommand(CMD0, 0, 0x95);

    if(response != 0x01)
    {
        SD_CS_HIGH();
        SPI1_Transfer(0xFF);
        return 1;
    }
    volatile uint8_t dummy;
    while(SPI1->SR & SPI_SR_RXNE)
        dummy = *((__IO uint8_t*)&SPI1->DR);
}
/* ============================================================ */
/* Read Single Block (512 bytes)                               */
/* ============================================================ */
uint8_t SD_ReadBlock(uint32_t sector, uint8_t *buffer)
{
    uint8_t response;
    uint8_t token;
    uint32_t timeout;

    /* For SDSC only */
    if(!SDHC_FLAG)
        sector *= 512;

    SD_CS_LOW();

    SPI1_Transfer(0xFF);
    SPI1_Transfer(0xFF);

    response = SD_SendCommand(CMD17, sector, 0xFF);

    char dbg[30];
    sprintf(dbg, "CMD17 Resp: %02X\r\n", response);
    UART2_Print(dbg);

    if(response != 0x00)
    {
        SD_CS_HIGH();
        SPI1_Transfer(0xFF);
        return 1;
    }

    for(int i=0;i<10;i++)
    {
        uint8_t t = SPI1_Transfer(0xFF);
        char dbg[20];
        sprintf(dbg,"Byte: %02X\r\n", t);
        UART2_Print(dbg);
    }

    /* Wait for data token 0xFE */
    timeout = 0xFFFF;

    do {
        token = SPI1_Transfer(0xFF);
        timeout--;
    } while(token != 0xFE && timeout);

    sprintf(dbg, "Token: %02X\r\n", token);
    UART2_Print(dbg);

    if(timeout == 0)
    {
        UART2_Print("Token Timeout\r\n");
        SD_CS_HIGH();
        SPI1_Transfer(0xFF);
        return 2;
    }

    /* Read 512 bytes */
    for(int i = 0; i < 512; i++)
        buffer[i] = SPI1_Transfer(0xFF);

    /* Ignore CRC */
    SPI1_Transfer(0xFF);
    SPI1_Transfer(0xFF);

    SD_CS_HIGH();
    SPI1_Transfer(0xFF);

    return 0;
}
/* ============================================================ */
/* Write Single Block                                           */
/* ============================================================ */
uint8_t SD_WriteBlock(uint32_t sector, uint8_t *buffer)
{
    uint8_t response;
    uint32_t timeout;

    if(!SDHC_FLAG)
        sector *= 512;

    SD_CS_LOW();

    response = SD_SendCommand(CMD24, sector, 0xFF);
    if(response != 0x00)
    {
        SD_CS_HIGH();
        SPI1_Transfer(0xFF);
        return 1;
    }

    /* Send data token */
    SPI1_Transfer(0xFE);

    for(int i = 0; i < 512; i++)
        SPI1_Transfer(buffer[i]);

    /* Dummy CRC */
    SPI1_Transfer(0xFF);
    SPI1_Transfer(0xFF);

    response = SPI1_Transfer(0xFF);

    if((response & 0x1F) != 0x05)
    {
        SD_CS_HIGH();
        SPI1_Transfer(0xFF);
        return 2;
    }

    /* Wait until card not busy */
    timeout = 0xFFFF;
    while(SPI1_Transfer(0xFF) == 0x00 && timeout)
        timeout--;

    SD_CS_HIGH();
    SPI1_Transfer(0xFF);

    return 0;
}
