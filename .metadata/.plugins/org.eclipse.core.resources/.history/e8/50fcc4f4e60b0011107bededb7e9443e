#include "main.h"
#include <stdio.h>
#include <string.h>

UART_HandleTypeDef huart2;

void SystemClock_Config(void);
static void MX_USART2_UART_Init(void);

void ADC_Init(void);
uint16_t ADC_Read(void);

int main(void)
{
  HAL_Init();
  SystemClock_Config();
  MX_USART2_UART_Init();

  while (1)
  {
    HAL_UART_Transmit(&huart2, (uint8_t*)"HELLO\r\n", 7, HAL_MAX_DELAY);
    HAL_Delay(1000);
  }
}

