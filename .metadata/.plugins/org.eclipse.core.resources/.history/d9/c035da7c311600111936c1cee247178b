#include "rcc.h"
#include "gpio.h"
#include "uart.h"
#include "spi.h"
#include "sdcard.h"
#include "i2c.h"
#include "bme280.h"
#include "logger.h"
#include <stdio.h>

void delay_ms(uint32_t ms)
{
    for(uint32_t j = 0; j < ms; j++)
        for(volatile uint32_t i = 0; i < 8000; i++);
}

int main(void)
{
    RCC_Init();
    GPIO_Init();
    UART2_Init();
    SPI1_Init();
    I2C1_Init();

    UART2_Print("Temperature Logger Start\r\n");

    /* SD Mount */
    Logger_Init();

    /* Sensor Init */
    BME280_Init();
    BME280_ReadCalibration();

    char dbg[30];
    sprintf(dbg, "PC13 = %lu\r\n", (GPIOC->IDR >> 13) & 1);
    UART2_Print(dbg);
    delay_ms(500);

    while(1)
    {
        float temp = BME280_ReadTemperature();
        Logger_LogTemperature(temp);

        if(Button_Pressed())
        {
            delay_ms(300);
            Logger_PrintFile();
        }

        delay_ms(1000);
    }
}
