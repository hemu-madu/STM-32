/* USER CODE BEGIN Header */
/* Complete SPI SD FatFS DiskIO Driver */
/* USER CODE END Header */

#include "ff_gen_drv.h"
#include "string.h"
#include "main.h"

extern SPI_HandleTypeDef hspi1;

/* ===================== CONFIG ===================== */
#define SD_CS_GPIO_Port GPIOA
#define SD_CS_Pin       GPIO_PIN_4
/* ================================================== */

static volatile DSTATUS Stat = STA_NOINIT;

/* ===================== SPI ===================== */

static uint8_t SPI_TxRx(uint8_t data)
{
    uint8_t rx;
    HAL_SPI_TransmitReceive(&hspi1, &data, &rx, 1, HAL_MAX_DELAY);
    return rx;
}

static void SD_Select(void)
{
    HAL_GPIO_WritePin(SD_CS_GPIO_Port, SD_CS_Pin, GPIO_PIN_RESET);
}

static void SD_Deselect(void)
{
    HAL_GPIO_WritePin(SD_CS_GPIO_Port, SD_CS_Pin, GPIO_PIN_SET);
    SPI_TxRx(0xFF);
}

static void SD_SendClockTrain(void)
{
    SD_Deselect();
    for (int i = 0; i < 10; i++)
        SPI_TxRx(0xFF);
}

/* ===================== SD COMMAND ===================== */

static uint8_t SD_SendCmd(uint8_t cmd, uint32_t arg)
{
    uint8_t crc = 0x01;

    if (cmd == 0) crc = 0x95;     // CMD0
    if (cmd == 8) crc = 0x87;     // CMD8

    SD_Select();

    SPI_TxRx(0x40 | cmd);
    SPI_TxRx(arg >> 24);
    SPI_TxRx(arg >> 16);
    SPI_TxRx(arg >> 8);
    SPI_TxRx(arg);
    SPI_TxRx(crc);

    for (int i = 0; i < 10; i++)
    {
        uint8_t response = SPI_TxRx(0xFF);
        if (!(response & 0x80))
            return response;
    }

    return 0xFF;
}

/* ===================== SD INIT ===================== */

static uint8_t SD_Init(void)
{
    SD_SendClockTrain();

    if (SD_SendCmd(0, 0) != 0x01)
        return 1;

    if (SD_SendCmd(8, 0x1AA) > 1)
        return 2;

    while (SD_SendCmd(55, 0) <= 1 &&
           SD_SendCmd(41, 0x40000000) != 0);

    SD_Deselect();
    Stat &= ~STA_NOINIT;
    return 0;
}

/* ===================== READ ===================== */

static uint8_t SD_ReadSector(uint8_t *buff, uint32_t sector)
{
    if (SD_SendCmd(17, sector * 512) != 0)
        return 1;

    while (SPI_TxRx(0xFF) != 0xFE);

    for (int i = 0; i < 512; i++)
        buff[i] = SPI_TxRx(0xFF);

    SPI_TxRx(0xFF);
    SPI_TxRx(0xFF);

    SD_Deselect();
    return 0;
}

/* ===================== WRITE ===================== */

static uint8_t SD_WriteSector(uint8_t *buff, uint32_t sector)
{
    if (SD_SendCmd(24, sector * 512) != 0)
        return 1;

    SPI_TxRx(0xFE);

    for (int i = 0; i < 512; i++)
        SPI_TxRx(buff[i]);

    SPI_TxRx(0xFF);
    SPI_TxRx(0xFF);

    if ((SPI_TxRx(0xFF) & 0x1F) != 0x05)
        return 2;

    while (!SPI_TxRx(0xFF));

    SD_Deselect();
    return 0;
}

/* ===================== FATFS INTERFACE ===================== */

DSTATUS USER_initialize(BYTE pdrv)
{
    if (pdrv != 0)
        return STA_NOINIT;

    if (SD_Init() == 0)
        return Stat;

    return STA_NOINIT;
}

DSTATUS USER_status(BYTE pdrv)
{
    return Stat;
}

DRESULT USER_read(BYTE pdrv, BYTE *buff, DWORD sector, UINT count)
{
    for (UINT i = 0; i < count; i++)
    {
        if (SD_ReadSector(buff + (i * 512), sector + i) != 0)
            return RES_ERROR;
    }
    return RES_OK;
}

#if _USE_WRITE == 1
DRESULT USER_write(BYTE pdrv, const BYTE *buff, DWORD sector, UINT count)
{
    for (UINT i = 0; i < count; i++)
    {
        if (SD_WriteSector((uint8_t*)(buff + (i * 512)), sector + i) != 0)
            return RES_ERROR;
    }
    return RES_OK;
}
#endif

#if _USE_IOCTL == 1
DRESULT USER_ioctl(BYTE pdrv, BYTE cmd, void *buff)
{
    switch (cmd)
    {
        case CTRL_SYNC:
            return RES_OK;

        case GET_SECTOR_SIZE:
            *(WORD*)buff = 512;
            return RES_OK;

        case GET_BLOCK_SIZE:
            *(DWORD*)buff = 1;
            return RES_OK;

        case GET_SECTOR_COUNT:
            *(DWORD*)buff = 32768;  // Dummy value
            return RES_OK;
    }

    return RES_PARERR;
}
#endif

Diskio_drvTypeDef USER_Driver =
{
  USER_initialize,
  USER_status,
  USER_read,
#if _USE_WRITE == 1
  USER_write,
#endif
#if _USE_IOCTL == 1
  USER_ioctl,
#endif
};
