/* Includes ------------------------------------------------------------------*/
#include "main.h"
#include "fatfs.h"
#include "stdio.h"
#include "string.h"

/* Private variables ---------------------------------------------------------*/
SPI_HandleTypeDef hspi1;
UART_HandleTypeDef huart2;

FATFS fs;
FIL fil;
FRESULT fres;
UINT bw;

/* Function Prototypes */
void SystemClock_Config(void);
static void MX_GPIO_Init(void);
static void MX_USART2_UART_Init(void);
static void MX_SPI1_Init(void);

/* Redirect printf to UART */
int __io_putchar(int ch)
{
    HAL_UART_Transmit(&huart2, (uint8_t *)&ch, 1, HAL_MAX_DELAY);
    return ch;
}

/* MAIN FUNCTION */
int main(void)
{
    HAL_Init();
    SystemClock_Config();

    MX_GPIO_Init();
    MX_USART2_UART_Init();
    MX_SPI1_Init();
    MX_FATFS_Init();

    printf("\r\n===== SD Logger Start =====\r\n");

    /* Mount SD Card */
    fres = f_mount(&fs, "", 1);
    if (fres != FR_OK)
    {
        printf("Mount Failed: %d\r\n", fres);
        while (1);
    }

    printf("Mount OK\r\n");

    /* Create or Open File */
    fres = f_open(&fil, "log.txt", FA_OPEN_ALWAYS | FA_WRITE);
    if (fres != FR_OK)
    {
        printf("File Open Error: %d\r\n", fres);
        while (1);
    }

    /* Move pointer to end of file */
    f_lseek(&fil, f_size(&fil));

    printf("File Ready\r\n");

    /* Infinite logging loop */
    while (1)
    {
        char data[64];

        sprintf(data, "STM32 Log Entry\r\n");

        fres = f_write(&fil, data, strlen(data), &bw);

        if (fres == FR_OK)
        {
            f_sync(&fil);   // Ensure data written to SD
            printf("Logged\r\n");
        }
        else
        {
            printf("Write Error: %d\r\n", fres);
        }

        HAL_Delay(2000);
    }
}
