#include "sd_spi.h"
//#include "spi.h"

extern SPI_HandleTypeDef hspi1;

#define SD_CS_LOW()   HAL_GPIO_WritePin(GPIOA, GPIO_PIN_4, GPIO_PIN_RESET)
#define SD_CS_HIGH()  HAL_GPIO_WritePin(GPIOA, GPIO_PIN_4, GPIO_PIN_SET)

#define CMD0    0
#define CMD8    8
#define CMD17   17
#define CMD24   24
#define CMD55   55
#define CMD41   41

static uint8_t SPI_TxRx(uint8_t data)
{
    uint8_t rx;
    HAL_SPI_TransmitReceive(&hspi1, &data, &rx, 1, HAL_MAX_DELAY);
    return rx;
}

static uint8_t SD_SendCmd(uint8_t cmd, uint32_t arg, uint8_t crc)
{
    uint8_t response;
    uint8_t frame[6];

    frame[0] = 0x40 | cmd;
    frame[1] = arg >> 24;
    frame[2] = arg >> 16;
    frame[3] = arg >> 8;
    frame[4] = arg;
    frame[5] = crc;

    SD_CS_LOW();
    SPI_TxRx(0xFF);

    HAL_SPI_Transmit(&hspi1, frame, 6, HAL_MAX_DELAY);

    for(int i = 0; i < 10; i++)
    {
        response = SPI_TxRx(0xFF);
        if(!(response & 0x80)) break;
    }

    SD_CS_HIGH();
    SPI_TxRx(0xFF);

    return response;
}

uint8_t SD_Init(void)
{
    SD_CS_HIGH();

    for(int i = 0; i < 10; i++)
        SPI_TxRx(0xFF);

    if(SD_SendCmd(CMD0, 0, 0x95) != 0x01)
        return 1;

    if(SD_SendCmd(CMD8, 0x1AA, 0x87) > 1)
        return 2;

    while(SD_SendCmd(CMD55, 0, 0xFF),
          SD_SendCmd(CMD41, 0x40000000, 0xFF) != 0);

    return 0;
}


uint8_t SD_ReadBlock(uint8_t *buff, uint32_t sector)
{
    uint8_t token;

//    sector *= 512;  // byte addressing for SDSC cards

    if (SD_SendCmd(CMD17, sector, 0xFF) != 0x00)
        return 1;

    SD_CS_LOW();

    // Wait for data token 0xFE
    uint32_t timeout = 0xFFFF;
    do {
        token = SPI_TxRx(0xFF);
        timeout--;
    } while ((token != 0xFE) && timeout);

    if (timeout == 0)
    {
        SD_CS_HIGH();
        return 2;
    }

    // Read 512 bytes
    for (int i = 0; i < 512; i++)
        buff[i] = SPI_TxRx(0xFF);

    // Read CRC
    SPI_TxRx(0xFF);
    SPI_TxRx(0xFF);

    SD_CS_HIGH();
    SPI_TxRx(0xFF);

    return 0;
}
