#include "stm32l476xx.h"
#include "gpio.h"

/* ========================================================= */
/* GPIO INIT                                                 */
/* ========================================================= */
void GPIO_Init(void)
{
    /* Enable GPIOA + GPIOC clocks */
    RCC->AHB2ENR |= RCC_AHB2ENR_GPIOAEN;
    RCC->AHB2ENR |= RCC_AHB2ENR_GPIOCEN;

    /* ===================================================== */
    /* ---------------- UART2 ------------------------------ */
    /* PA2 = TX, PA3 = RX                                   */
    /* ===================================================== */

    GPIOA->MODER &= ~(GPIO_MODER_MODE2 | GPIO_MODER_MODE3);
    GPIOA->MODER |=  (GPIO_MODER_MODE2_1 | GPIO_MODER_MODE3_1);  // AF mode

    GPIOA->AFR[0] &= ~((0xF << (2*4)) | (0xF << (3*4)));
    GPIOA->AFR[0] |=  (7 << (2*4)) | (7 << (3*4));  // AF7 = USART2

    GPIOA->PUPDR &= ~(GPIO_PUPDR_PUPD2 | GPIO_PUPDR_PUPD3);
    GPIOA->PUPDR |=  GPIO_PUPDR_PUPD3_0;  // RX pull-up


    /* ===================================================== */
    /* ---------------- SPI1 ------------------------------- */
    /* PA5=SCK, PA6=MISO, PA7=MOSI                          */
    /* ===================================================== */

    GPIOA->MODER &= ~(GPIO_MODER_MODE5 |
                      GPIO_MODER_MODE6 |
                      GPIO_MODER_MODE7);

    GPIOA->MODER |=  (GPIO_MODER_MODE5_1 |
                      GPIO_MODER_MODE6_1 |
                      GPIO_MODER_MODE7_1);   // AF mode

    GPIOA->AFR[0] &= ~((0xF << (5*4)) |
                       (0xF << (6*4)) |
                       (0xF << (7*4)));

    GPIOA->AFR[0] |=  (5 << (5*4)) |
                      (5 << (6*4)) |
                      (5 << (7*4));   // AF5 = SPI1

    /* MISO pull-up (important for SD) */
    GPIOA->PUPDR &= ~(GPIO_PUPDR_PUPD6);
    GPIOA->PUPDR |=  GPIO_PUPDR_PUPD6_0;


    /* ===================================================== */
    /* ---------------- SD CS (PA4) ------------------------ */
    /* ===================================================== */

    GPIOA->MODER &= ~(GPIO_MODER_MODE4);
    GPIOA->MODER |=  GPIO_MODER_MODE4_0;   // Output mode

    GPIOA->OTYPER &= ~(GPIO_OTYPER_OT4);   // Push-pull

    GPIOA->OSPEEDR |= (3 << (4*2));        // High speed

    GPIOA->ODR |= GPIO_ODR_OD4;            // CS HIGH (inactive)


    /* ===================================================== */
    /* ---------------- USER BUTTON PC13 ------------------- */
    /* ===================================================== */

    GPIOC->MODER &= ~(3 << (13 * 2));      // Input mode
    GPIOC->PUPDR &= ~(3 << (13 * 2));      // No pull (external pull-down on board)
}


/* ========================================================= */
/* Polling-based button check                               */
/* ========================================================= */
uint8_t Button_Pressed(void)
{
    /* PC13 is active LOW */
    if(!(GPIOC->IDR & (1 << 13)))
        return 1;

    return 0;
}
