#include "stm32l476xx.h"
#include "rcc.h"
#include "gpio.h"
#include "uart.h"
#include "spi.h"
#include "i2c.h"
#include "sdcard.h"
#include "ff.h"
#include "bme280.h"
#include "rtc.h"
#include <stdio.h>
#include <string.h>

#define SAMPLE_COUNT  10

FATFS fs;
FIL file;
UINT bw, br;

char buffer[256];

void delay_ms(uint32_t ms)
{
    for(uint32_t i=0;i<ms*4000;i++);
}

int main(void)
{
    RCC_Init();
    GPIO_Init();
    UART2_Init();
    SPI1_Init();
    I2C1_Init();
    RTC_Init();
    BME280_Init();

    if(f_mount(&fs, "", 1) != FR_OK)
    {
        while(1);
    }

    float temp_buffer[SAMPLE_COUNT];
    uint8_t index = 0;

    while(1)
    {
        /* ===== FAST READ ===== */
        temp_buffer[index++] = BME280_ReadTemperature();

        delay_ms(200);   // Fast sampling

        /* ===== When 10 samples collected ===== */
        if(index >= SAMPLE_COUNT)
        {
            if(f_open(&file, "temperature_logs.txt",
                      FA_OPEN_APPEND | FA_WRITE) == FR_OK)
            {
                for(uint8_t i=0; i<SAMPLE_COUNT; i++)
                {
                    char line[32];
                    sprintf(line, "%.2f C\r\n", temp_buffer[i]);
                    f_write(&file, line, strlen(line), &bw);
                }

                f_close(&file);
            }

            index = 0;   // reset buffer
        }

        /* ===== Button Press -> Print File ===== */
        if(Button_Pressed())
        {
            delay_ms(200);  // debounce

            if(Button_Pressed())
            {
                UART2_Print("\r\n--- STORED DATA ---\r\n");

                if(f_open(&file, "temperature_logs.txt", FA_READ) == FR_OK)
                {
                    while(1)
                    {
                        if(f_read(&file, buffer,
                                  sizeof(buffer)-1, &br) != FR_OK || br == 0)
                            break;

                        buffer[br] = 0;
                        UART2_Print(buffer);
                    }

                    f_close(&file);
                }

                UART2_Print("\r\n-------------------\r\n");

                while(Button_Pressed());
            }
        }
    }
}
