#include "stm32l476xx.h"
#include "rcc.h"
#include "gpio.h"
#include "uart.h"

void delay_ms(uint32_t ms)
{
    for(uint32_t j=0;j<ms;j++)
        for(volatile uint32_t i=0;i<8000;i++);
}

int main(void)
{
    RCC_Init();
    GPIO_Init();
    UART2_Init();

    UART2_Print("Button Test Start\r\n");
    while(1)
    {
        if(Button_Pressed())
            UART2_Print("PRESSED\r\n");
        else
            UART2_Print("NOT PRESSED\r\n");

        delay_ms(500);
    }
}
