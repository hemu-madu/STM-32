#include "main.h"
#include <stdio.h>

UART_HandleTypeDef huart2;

void SystemClock_Config(void);
static void MX_USART2_UART_Init(void);

void ADC_Init(void);
uint16_t ADC_Read(void);

int main(void)
{
  HAL_Init();
  SystemClock_Config();
  MX_USART2_UART_Init();

  ADC_Init();

  char msg[50];
  uint16_t adc_val;

  while (1)
  {
    adc_val = ADC_Read();

    sprintf(msg, "ADC Value: %d\r\n", adc_val);
    HAL_UART_Transmit(&huart2, (uint8_t*)msg, strlen(msg), 100);

    HAL_Delay(1000);
  }
}


void ADC_Init(void)
{
    RCC->AHB2ENR |= RCC_AHB2ENR_ADCEN;   // Enable ADC clock

    ADC123_COMMON->CCR |= ADC_CCR_VSENSESEL; // Enable temp sensor

    ADC1->CR &= ~ADC_CR_DEEPPWD;   // Exit deep power down
    ADC1->CR |= ADC_CR_ADVREGEN;   // Enable regulator
    HAL_Delay(10);

    ADC1->CR &= ~ADC_CR_ADEN;
    ADC1->CR |= ADC_CR_ADCAL;   // Calibration
    while (ADC1->CR & ADC_CR_ADCAL);

    ADC1->ISR |= ADC_ISR_ADRDY;
    ADC1->CR |= ADC_CR_ADEN;   // Enable ADC
    while (!(ADC1->ISR & ADC_ISR_ADRDY));

    ADC1->SQR1 &= ~ADC_SQR1_L; // 1 conversion
    ADC1->SQR1 |= (16 << ADC_SQR1_SQ1_Pos); // Channel 16 (Temp sensor)
}

uint16_t ADC_Read(void)
{
    ADC1->CR |= ADC_CR_ADSTART;  // Start conversion

    while (!(ADC1->ISR & ADC_ISR_EOC));

    return ADC1->DR;
}
