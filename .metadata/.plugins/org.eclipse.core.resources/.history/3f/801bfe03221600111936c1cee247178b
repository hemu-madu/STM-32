#include "sdcard.h"
#include "spi.h"

#define CMD0   0
#define CMD8   8
#define CMD55  55
#define CMD41  41
#define CMD58  58
#define CMD17  17
#define CMD24  24
#define CMD16  16

uint8_t SDHC_FLAG = 0;

static uint8_t SD_SendCommand(uint8_t cmd, uint32_t arg, uint8_t crc)
{
    uint8_t response;
    uint32_t timeout = 0xFFFF;

    SPI1_Transfer(0x40 | cmd);
    SPI1_Transfer(arg >> 24);
    SPI1_Transfer(arg >> 16);
    SPI1_Transfer(arg >> 8);
    SPI1_Transfer(arg);
    SPI1_Transfer(crc);

    do {
        response = SPI1_Transfer(0xFF);
        timeout--;
    } while((response & 0x80) && timeout);

    return response;
}

uint8_t SD_Init(void)
{
    uint8_t response;
    uint32_t timeout;

    SD_CS_HIGH();
    for(int i=0;i<10;i++)
        SPI1_Transfer(0xFF);

    SD_CS_LOW();

    response = SD_SendCommand(CMD0, 0, 0x95);
    if(response != 0x01) return 1;

    response = SD_SendCommand(CMD8, 0x1AA, 0x87);
    if(response != 0x01) return 2;

    timeout = 0xFFFF;

    do {
        SD_SendCommand(CMD55, 0, 0xFF);
        response = SD_SendCommand(CMD41, 0x40000000, 0xFF);
        timeout--;
    } while(response != 0x00 && timeout);

    if(timeout == 0) return 3;

    response = SD_SendCommand(CMD58, 0, 0xFF);
    if(response != 0x00) return 4;

    SD_CS_HIGH();
    SPI1_Transfer(0xFF);

    return 0;
}
