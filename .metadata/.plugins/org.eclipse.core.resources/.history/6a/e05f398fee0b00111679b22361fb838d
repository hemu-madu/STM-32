#include "stm32l476xx.h"

volatile uint32_t msTicks = 0;

void delay_ms(uint32_t ms)
{
    uint32_t start = msTicks;
    while ((msTicks - start) < ms);
}

int main(void)
{
    /* Enable GPIOA clock */
    RCC->AHB2ENR |= RCC_AHB2ENR_GPIOAEN;

    /* Set PA5 as output */
    GPIOA->MODER &= ~(3 << (5 * 2));
    GPIOA->MODER |=  (1 << (5 * 2));

    /* SysTick for 1ms (Assuming 16 MHz default clock) */
    SysTick->LOAD = 16000 - 1;
    SysTick->VAL  = 0;
    SysTick->CTRL = 7;

    while (1)
    {
        GPIOA->ODR ^= (1 << 5);
        delay_ms(1000);
    }
}
