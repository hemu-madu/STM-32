#include "main.h"
#include <string.h>
#include <stdio.h>

/* Private variables ---------------------------------------------------------*/
SPI_HandleTypeDef hspi1;
DMA_HandleTypeDef hdma_spi1_tx;
DMA_HandleTypeDef hdma_spi1_rx;
UART_HandleTypeDef huart2;

/* USER CODE BEGIN PV */
uint8_t txData[] = "Hello SPI DMA\r\n";
uint8_t rxData[20];
char uartBuf[50];
/* USER CODE END PV */

void SystemClock_Config(void);
static void MX_GPIO_Init(void);
static void MX_DMA_Init(void);
static void MX_USART2_UART_Init(void);
static void MX_SPI1_Init(void);

/* USER CODE BEGIN 0 */

/* DMA Complete Callback */
void HAL_SPI_TxRxCpltCallback(SPI_HandleTypeDef *hspi)
{
    if(hspi->Instance == SPI1)
    {
        sprintf(uartBuf, "Received: %s", rxData);
        HAL_UART_Transmit(&huart2, (uint8_t*)uartBuf,
                          strlen(uartBuf), HAL_MAX_DELAY);
    }
}
/* USER CODE END 0 */

int main(void)
{
  HAL_Init();
  SystemClock_Config();

  MX_GPIO_Init();
  MX_DMA_Init();
  MX_USART2_UART_Init();
  MX_SPI1_Init();

  /* USER CODE BEGIN 2 */

  /* Start SPI DMA Transfer */
  HAL_SPI_TransmitReceive_DMA(&hspi1,
                              txData,
                              rxData,
                              sizeof(txData));

  /* USER CODE END 2 */

  while (1)
  {
      /* Infinite loop */
  }
}
