#include "main.h"

extern SPI_HandleTypeDef hspi1;

#define SD_CS_LOW()   HAL_GPIO_WritePin(GPIOA, GPIO_PIN_4, GPIO_PIN_RESET)
#define SD_CS_HIGH()  HAL_GPIO_WritePin(GPIOA, GPIO_PIN_4, GPIO_PIN_SET)

uint8_t SPI_TxRx(uint8_t data)
{
    uint8_t rx;
    HAL_SPI_TransmitReceive(&hspi1, &data, &rx, 1, HAL_MAX_DELAY);
    return rx;
}

void SD_SendClock(void)
{
    for(int i=0;i<10;i++)
        SPI_TxRx(0xFF);
}

uint8_t SD_SendCmd(uint8_t cmd, uint32_t arg, uint8_t crc)
{
    uint8_t response;
    uint8_t frame[6];

    frame[0] = cmd | 0x40;
    frame[1] = arg >> 24;
    frame[2] = arg >> 16;
    frame[3] = arg >> 8;
    frame[4] = arg;
    frame[5] = crc;

    SD_CS_LOW();

    for(int i=0;i<6;i++)
        SPI_TxRx(frame[i]);

    for(int i=0;i<10;i++)
    {
        response = SPI_TxRx(0xFF);
        if(!(response & 0x80))
            break;
    }

    return response;
}
