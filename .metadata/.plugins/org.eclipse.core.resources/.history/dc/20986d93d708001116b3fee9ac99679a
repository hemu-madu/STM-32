#include "stm32l476xx.h"

/* Simple delay (optional) */
void delay(void)
{
    for(volatile int i = 0; i < 200000; i++);
}

int main(void)
{
    /* ===============================
       1️⃣ Enable Required Clocks
       =============================== */
    RCC->AHB2ENR |= RCC_AHB2ENR_GPIOAEN;   // GPIOA clock enable
    RCC->AHB2ENR |= RCC_AHB2ENR_GPIOCEN;   // GPIOC clock enable
    RCC->APB2ENR |= RCC_APB2ENR_SYSCFGEN;  // SYSCFG clock enable


    /* ===============================
       2️⃣ Configure PA5 as Output (LED)
       =============================== */
    GPIOA->MODER &= ~(3 << (5 * 2));  // Clear mode bits
    GPIOA->MODER |=  (1 << (5 * 2));  // Set as General Purpose Output

    GPIOA->OTYPER &= ~(1 << 5);       // Push-pull
    GPIOA->OSPEEDR |= (3 << (5 * 2)); // High speed
    GPIOA->PUPDR &= ~(3 << (5 * 2));  // No pull-up/pull-down


    /* ===============================
       3️⃣ Configure PC13 as Input (Button)
       =============================== */
    GPIOC->MODER &= ~(3 << (13 * 2));  // Input mode

    GPIOC->PUPDR &= ~(3 << (13 * 2));
    GPIOC->PUPDR |=  (1 << (13 * 2));  // Pull-up enabled


    /* ===============================
       4️⃣ Configure EXTI Line 13
       =============================== */

    // Map PC13 to EXTI13
    SYSCFG->EXTICR[3] &= ~(0xF << 4);
    SYSCFG->EXTICR[3] |=  (0x2 << 4);  // Port C = 0x2

    EXTI->IMR1  |= (1 << 13);   // Unmask interrupt
    EXTI->FTSR1 |= (1 << 13);   // Falling edge trigger


    /* ===============================
       5️⃣ Enable NVIC Interrupt
       =============================== */
    NVIC_EnableIRQ(EXTI15_10_IRQn);


    /* ===============================
       6️⃣ Infinite Loop
       =============================== */
    while(1)
    {
        // CPU waits for interrupt
    }
}
