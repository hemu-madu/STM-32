#include "stm32l476xx.h"
#include "gpio.h"

void GPIO_Init(void)
{
    /* Enable GPIOA + GPIOB + GPIOC clocks */
    RCC->AHB2ENR |= RCC_AHB2ENR_GPIOAEN;
    RCC->AHB2ENR |= RCC_AHB2ENR_GPIOBEN;
    RCC->AHB2ENR |= RCC_AHB2ENR_GPIOCEN;

    /* ================= UART2 (PA2, PA3) ================= */
    GPIOA->MODER &= ~(GPIO_MODER_MODE2 | GPIO_MODER_MODE3);
    GPIOA->MODER |=  (GPIO_MODER_MODE2_1 | GPIO_MODER_MODE3_1);
    GPIOA->AFR[0] |= (7 << (2*4)) | (7 << (3*4));
    GPIOA->PUPDR |= GPIO_PUPDR_PUPD3_0;

    /* ================= SPI1 on PORT B ================= */
    /* PB3 = SCK, PB4 = MISO, PB5 = MOSI */

    GPIOB->MODER &= ~(GPIO_MODER_MODE3 |
                      GPIO_MODER_MODE4 |
                      GPIO_MODER_MODE5);

    GPIOB->MODER |=  (GPIO_MODER_MODE3_1 |
                      GPIO_MODER_MODE4_1 |
                      GPIO_MODER_MODE5_1);   // AF mode

    GPIOB->AFR[0] &= ~((0xF << (3*4)) |
                       (0xF << (4*4)) |
                       (0xF << (5*4)));

    GPIOB->AFR[0] |=  (5 << (3*4)) |   // AF5 = SPI1
                      (5 << (4*4)) |
                      (5 << (5*4));

    /* MISO pull-up (important for SD) */
    GPIOB->PUPDR &= ~(GPIO_PUPDR_PUPD4);
    GPIOB->PUPDR |=  GPIO_PUPDR_PUPD4_0;

    /* ================= CS on PB8 ================= */
    GPIOB->MODER &= ~(GPIO_MODER_MODE8);
    GPIOB->MODER |=  GPIO_MODER_MODE8_0;   // Output

    GPIOB->OTYPER &= ~(GPIO_OTYPER_OT8);   // Push-pull
    GPIOB->OSPEEDR |= (3 << (8*2));        // High speed

    GPIOB->ODR |= GPIO_ODR_OD8;            // CS HIGH

    /* -------- PB6 = I2C1_SCL -------- */
    GPIOB->MODER &= ~(3 << (6 * 2));
    GPIOB->MODER |=  (2 << (6 * 2));   // Alternate function

    GPIOB->OTYPER |= (1 << 6);        // Open-drain

    GPIOB->OSPEEDR |= (3 << (6 * 2)); // High speed

    GPIOB->PUPDR &= ~(3 << (6 * 2));
    GPIOB->PUPDR |=  (1 << (6 * 2));  // Pull-up

    GPIOB->AFR[0] &= ~(0xF << (6 * 4));
    GPIOB->AFR[0] |=  (4 << (6 * 4)); // AF4 = I2C1


    /* -------- PB7 = I2C1_SDA -------- */
    GPIOB->MODER &= ~(3 << (7 * 2));
    GPIOB->MODER |=  (2 << (7 * 2));   // Alternate function

    GPIOB->OTYPER |= (1 << 7);        // Open-drain

    GPIOB->OSPEEDR |= (3 << (7 * 2)); // High speed

    GPIOB->PUPDR &= ~(3 << (7 * 2));
    GPIOB->PUPDR |=  (1 << (7 * 2));  // Pull-up

    GPIOB->AFR[0] &= ~(0xF << (7 * 4));
    GPIOB->AFR[0] |=  (4 << (7 * 4)); // AF4 = I2C1

       /* ================= USER BUTTON PC13 ================= */
    /* ================= USER BUTTON PC13 ================= */
    GPIOC->MODER &= ~(3 << (13 * 2));   // Input mode

    GPIOC->PUPDR &= ~(3 << (13 * 2));
    GPIOC->PUPDR |=  (1 << (13 * 2));   // Enable pull-up
}

uint8_t Button_Pressed(void)
{
    return ((GPIOC->IDR & (1 << 13)) == 0);  // ACTIVE LOW
}
