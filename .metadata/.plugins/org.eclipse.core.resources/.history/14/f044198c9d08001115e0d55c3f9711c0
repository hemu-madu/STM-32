#include "stm32l476xx.h"

int main(void)
{
    // Enable GPIOA clock
    RCC->AHB2ENR |= (1 << 0);

    // Set PA5 as Output (MODER5 = 01)
    GPIOA->MODER &= ~(3 << (5 * 2));
    GPIOA->MODER |=  (1 << (5 * 2));

    while(1)
    {
        GPIOA->ODR ^= (1 << 5);   // Toggle PA5
        for(int i=0; i<1000000; i++); // Delay
    }
}
