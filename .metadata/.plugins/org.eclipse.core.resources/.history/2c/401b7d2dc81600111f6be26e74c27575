#include "rtc.h"

static uint8_t bcd2dec(uint8_t bcd)
{
    return ((bcd >> 4) * 10) + (bcd & 0x0F);
}

void RTC_Init(void)
{
    /* Enable PWR clock */
    RCC->APB1ENR1 |= RCC_APB1ENR1_PWREN;

    /* Enable access to backup domain */
    PWR->CR1 |= PWR_CR1_DBP;

    /* Enable LSE */
    RCC->BDCR |= RCC_BDCR_LSEON;
    while(!(RCC->BDCR & RCC_BDCR_LSERDY));

    /* Select LSE as RTC clock */
    RCC->BDCR |= RCC_BDCR_RTCSEL_0;
    RCC->BDCR |= RCC_BDCR_RTCEN;

    /* Disable write protection */
    RTC->WPR = 0xCA;
    RTC->WPR = 0x53;

    /* Enter init mode */
    RTC->ISR |= RTC_ISR_INIT;
    while(!(RTC->ISR & RTC_ISR_INITF));

    /* Set prescaler */
    RTC->PRER = (127 << 16) | 255;

    /* Example initial time: 12:00:00 */
    RTC->TR = (0x12 << 16);
    RTC->DR = (0x01 << 13) | (0x01 << 8) | 0x24;  // 01-01-24

    /* Exit init mode */
    RTC->ISR &= ~RTC_ISR_INIT;

    /* Enable write protection */
    RTC->WPR = 0xFF;
}

void RTC_Get_Time(uint8_t *hour, uint8_t *min, uint8_t *sec)
{
    uint32_t tr = RTC->TR;

    *hour = bcd2dec((tr >> 16) & 0x3F);
    *min  = bcd2dec((tr >> 8) & 0x7F);
    *sec  = bcd2dec(tr & 0x7F);
}

void RTC_Get_Date(uint8_t *date, uint8_t *month, uint8_t *year)
{
    uint32_t dr = RTC->DR;

    *date  = bcd2dec(dr & 0x3F);
    *month = bcd2dec((dr >> 8) & 0x1F);
    *year  = bcd2dec((dr >> 16) & 0xFF);
}
