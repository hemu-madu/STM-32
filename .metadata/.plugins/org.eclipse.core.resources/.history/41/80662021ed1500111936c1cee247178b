#include "main.h"

extern SPI_HandleTypeDef hspi1;

#define SD_CS_LOW()   HAL_GPIO_WritePin(GPIOA, GPIO_PIN_4, GPIO_PIN_RESET)
#define SD_CS_HIGH()  HAL_GPIO_WritePin(GPIOA, GPIO_PIN_4, GPIO_PIN_SET)

uint8_t SPI_TxRx(uint8_t data)
{
    uint8_t rx;
    HAL_SPI_TransmitReceive(&hspi1, &data, &rx, 1, HAL_MAX_DELAY);
    return rx;
}

void SD_SendClock(void)
{
    for(int i=0;i<10;i++)
        SPI_TxRx(0xFF);
}

uint8_t SD_SendCmd(uint8_t cmd, uint32_t arg, uint8_t crc)
{
    uint8_t response;
    uint8_t frame[6];

    frame[0] = cmd | 0x40;
    frame[1] = arg >> 24;
    frame[2] = arg >> 16;
    frame[3] = arg >> 8;
    frame[4] = arg;
    frame[5] = crc;

    SD_CS_LOW();

    for(int i=0;i<6;i++)
        SPI_TxRx(frame[i]);

    for(int i=0;i<10;i++)
    {
        response = SPI_TxRx(0xFF);
        if(!(response & 0x80))
            break;
    }

    return response;
}

uint8_t SD_Init(void)
{
    uint8_t response;
    uint16_t retry = 0;

    SD_CS_HIGH();
    SD_SendClock();

    SD_CS_LOW();

    response = SD_SendCmd(0, 0, 0x95);  // CMD0
    if(response != 0x01)
        return 1;

    response = SD_SendCmd(8, 0x1AA, 0x87);  // CMD8
    if(response != 0x01)
        return 2;

    SPI_TxRx(0xFF); SPI_TxRx(0xFF);
    SPI_TxRx(0xFF); SPI_TxRx(0xFF);

    do
    {
        SD_SendCmd(55, 0, 0x01);
        response = SD_SendCmd(41, 0x40000000, 0x01);
        retry++;
    } while(response != 0x00 && retry < 1000);

    SD_CS_HIGH();

    if(retry >= 1000)
        return 3;

    return 0;
}
