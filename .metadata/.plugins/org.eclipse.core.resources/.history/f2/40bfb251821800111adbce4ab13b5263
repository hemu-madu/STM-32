/* ============================================================
   Pin & SPI Macros
   ============================================================ */
#define SD_CS_LOW()   HAL_GPIO_WritePin(SD_CS_GPIO_Port, SD_CS_Pin, GPIO_PIN_RESET)
#define SD_CS_HIGH()  HAL_GPIO_WritePin(SD_CS_GPIO_Port, SD_CS_Pin, GPIO_PIN_SET)

/* SD Card Command Definitions */
#define CMD0    (0x40+0)    // GO_IDLE_STATE
#define CMD8    (0x40+8)    // SEND_IF_COND
#define CMD9    (0x40+9)    // SEND_CSD
#define CMD10   (0x40+10)   // SEND_CID
#define CMD12   (0x40+12)   // STOP_TRANSMISSION
#define CMD16   (0x40+16)   // SET_BLOCKLEN
#define CMD17   (0x40+17)   // READ_SINGLE_BLOCK
#define CMD18   (0x40+18)   // READ_MULTIPLE_BLOCK
#define CMD23   (0x40+23)   // SET_BLOCK_COUNT
#define CMD24   (0x40+24)   // WRITE_BLOCK
#define CMD25   (0x40+25)   // WRITE_MULTIPLE_BLOCK
#define CMD41   (0x40+41)   // SEND_OP_COND (SDC)
#define CMD55   (0x40+55)   // APP_CMD
#define CMD58   (0x40+58)   // READ_OCR

/* Card type flags */
#define CT_MMC      0x01
#define CT_SD1      0x02
#define CT_SD2      0x04
#define CT_SDC      (CT_SD1|CT_SD2)
#define CT_BLOCK    0x08

extern SPI_HandleTypeDef hspi1;

static volatile DSTATUS Stat = STA_NOINIT;
static uint8_t CardType = 0;

/* USER CODE END DECL */

/* Private function prototypes -----------------------------------------------*/
DSTATUS USER_initialize(BYTE pdrv);
DSTATUS USER_status(BYTE pdrv);
DRESULT USER_read(BYTE pdrv, BYTE *buff, DWORD sector, UINT count);
#if _USE_WRITE == 1
DRESULT USER_write(BYTE pdrv, const BYTE *buff, DWORD sector, UINT count);
#endif
#if _USE_IOCTL == 1
DRESULT USER_ioctl(BYTE pdrv, BYTE cmd, void *buff);
#endif

Diskio_drvTypeDef USER_Driver = {
    USER_initialize,
    USER_status,
    USER_read,
#if _USE_WRITE
    USER_write,
#endif
#if _USE_IOCTL == 1
    USER_ioctl,
#endif
};

/* ============================================================
   SPI Low-Level Helpers
   ============================================================ */

/* Send one byte, receive one byte */
static uint8_t SPI_TxRx(uint8_t tx) {
    uint8_t rx = 0xFF;
    HAL_SPI_TransmitReceive(&hspi1, &tx, &rx, 1, 1000);
    return rx;
}

/* Send dummy 0xFF to release bus */
static void SPI_Release(void) {
    SPI_TxRx(0xFF);
}

/* Wait until SD card is not busy (returns 0xFF = ready) */
static uint8_t SD_WaitReady(uint32_t timeout_ms) {
    uint8_t res;
    uint32_t t = HAL_GetTick();
    do {
        res = SPI_TxRx(0xFF);
        if (res == 0xFF) return 0xFF;  // Ready
    } while ((HAL_GetTick() - t) < timeout_ms);
    return res;  // Timeout
}

/* Deselect SD and release SPI */
static void SD_Deselect(void) {
    SD_CS_HIGH();
    SPI_Release();  // Give SD card 1 extra clock to finish
}

/* Select SD card, wait until ready */
static uint8_t SD_Select(void) {
    SD_CS_LOW();
    SPI_Release();
    if (SD_WaitReady(500) == 0xFF) return 1;  // Success
    SD_Deselect();
    return 0;  // Failed
}

/* Send SD command, return R1 response byte */
static uint8_t SD_SendCmd(uint8_t cmd, uint32_t arg) {
    uint8_t crc, res;
    uint8_t n;

    /* ACMD = CMD55 prefix */
    if (cmd & 0x80) {
        cmd &= 0x7F;
        res = SD_SendCmd(CMD55, 0);
        if (res > 1) return res;
    }

    /* Re-select card */
    SD_Deselect();
    if (!SD_Select()) return 0xFF;

    /* Send 6-byte command frame */
    SPI_TxRx(cmd);
    SPI_TxRx((uint8_t)(arg >> 24));
    SPI_TxRx((uint8_t)(arg >> 16));
    SPI_TxRx((uint8_t)(arg >> 8));
    SPI_TxRx((uint8_t)(arg));

    /* CRC (only needed for CMD0 and CMD8, else dummy) */
    crc = 0x01;
    if (cmd == CMD0) crc = 0x95;
    if (cmd == CMD8) crc = 0x87;
    SPI_TxRx(crc);

    /* Skip 1 byte for CMD12 STOP */
    if (cmd == CMD12) SPI_TxRx(0xFF);

    /* Wait for valid response (up to 10 retries) */
    n = 10;
    do {
        res = SPI_TxRx(0xFF);
    } while ((res & 0x80) && --n);

    return res;
}

/* Receive a 512-byte data block */
static int SD_RxDataBlock(BYTE *buff, UINT btr) {
    uint8_t token;
    uint32_t t = HAL_GetTick();

    /* Wait for data token 0xFE */
    do {
        token = SPI_TxRx(0xFF);
    } while ((token == 0xFF) && (HAL_GetTick() - t) < 200);

    if (token != 0xFE) return 0;  // Bad token

    /* Read data bytes */
    do {
        *buff++ = SPI_TxRx(0xFF);
        *buff++ = SPI_TxRx(0xFF);
    } while (btr -= 2);

    /* Discard 2-byte CRC */
    SPI_TxRx(0xFF);
    SPI_TxRx(0xFF);

    return 1;
}

/* Transmit a 512-byte data block */
#if _USE_WRITE == 1
static int SD_TxDataBlock(const BYTE *buff, BYTE token) {
    uint8_t resp;
    uint16_t i;

    if (SD_WaitReady(500) != 0xFF) return 0;

    SPI_TxRx(token);  // Send token

    if (token != 0xFD) {  // Not STOP token — send data
        for (i = 0; i < 512; i++) {
            SPI_TxRx(*buff++);
        }
        SPI_TxRx(0xFF);  // Dummy CRC
        SPI_TxRx(0xFF);

        resp = SPI_TxRx(0xFF);  // Data response
        if ((resp & 0x1F) != 0x05) return 0;  // Rejected
    }
    return 1;
}
#endif

/* ============================================================
   Increase SPI speed after init (call once card is ready)
   ============================================================ */
static void SPI_SpeedUp(void) {
    hspi1.Init.BaudRatePrescaler = SPI_BAUDRATEPRESCALER_8; // 80MHz/8 = 10MHz
    HAL_SPI_Init(&hspi1);
}

/* ============================================================
   FatFS DiskIO Interface Functions
   ============================================================ */

DSTATUS USER_initialize(BYTE pdrv) {
    uint8_t n, cmd, ty, ocr[4];
    uint32_t timeout;

    if (pdrv) return STA_NOINIT;

    /* Make sure SPI is slow for init (400kHz max) */
    hspi1.Init.BaudRatePrescaler = SPI_BAUDRATEPRESCALER_256;
    HAL_SPI_Init(&hspi1);

    /* Power-up: send >=74 dummy clocks with CS HIGH */
    SD_CS_HIGH();
    HAL_Delay(10);  // Wait for SD power stable
    for (n = 20; n; n--) SPI_TxRx(0xFF);  // 160 clocks

    ty = 0;

    /* CMD0: Put SD into SPI mode (expect R1 = 0x01) */
    if (SD_SendCmd(CMD0, 0) == 1) {

        timeout = HAL_GetTick();

        /* CMD8: Check SD version (SDv2?) */
        if (SD_SendCmd(CMD8, 0x1AA) == 1) {
            /* SDv2 — read 4-byte R7 response */
            for (n = 0; n < 4; n++) ocr[n] = SPI_TxRx(0xFF);

            if (ocr[2] == 0x01 && ocr[3] == 0xAA) {
                /* Voltage accepted — wait for card ready (ACMD41 with HCS bit) */
                while ((HAL_GetTick() - timeout) < 2000) {
                    if (SD_SendCmd((0x80|CMD41), 1UL << 30) == 0) break;
                    HAL_Delay(10);
                }

                /* Read OCR to check CCS bit (block vs byte addressing) */
                if ((HAL_GetTick() - timeout) < 2000 && SD_SendCmd(CMD58, 0) == 0) {
                    for (n = 0; n < 4; n++) ocr[n] = SPI_TxRx(0xFF);
                    ty = (ocr[0] & 0x40) ? CT_SD2 | CT_BLOCK : CT_SD2;  // SDHC or SDSC
                }
            }
        } else {
            /* SDv1 or MMC */
            if (SD_SendCmd((0x80|CMD41), 0) <= 1) {
                ty  = CT_SD1;
                cmd = (0x80|CMD41);
            } else {
                ty  = CT_MMC;
                cmd = CMD1;
            }

            /* Wait for ready */
            while ((HAL_GetTick() - timeout) < 2000) {
                if (SD_SendCmd(cmd, 0) == 0) break;
                HAL_Delay(10);
            }

            /* Set block size to 512 bytes */
            if ((HAL_GetTick() - timeout) >= 2000 || SD_SendCmd(CMD16, 512) != 0)
                ty = 0;
        }
    } else {
        /* CMD0 failed — SD card not responding */
        SD_Deselect();
        return STA_NOINIT;
    }

    CardType = ty;
    SD_Deselect();

    if (ty) {
        Stat &= ~STA_NOINIT;  // Initialization successful
        SPI_SpeedUp();          // Increase SPI speed now
    }

    return Stat;
}

DSTATUS USER_status(BYTE pdrv) {
    if (pdrv) return STA_NOINIT;
    return Stat;
}

DRESULT USER_read(BYTE pdrv, BYTE *buff, DWORD sector, UINT count) {
    if (pdrv || !count) return RES_PARERR;
    if (Stat & STA_NOINIT) return RES_NOTRDY;

    /* Convert sector address for byte-addressed cards */
    if (!(CardType & CT_BLOCK)) sector *= 512;

    if (count == 1) {
        if (SD_SendCmd(CMD17, sector) == 0 && SD_RxDataBlock(buff, 512))
            count = 0;
    } else {
        if (SD_SendCmd(CMD18, sector) == 0) {
            do {
                if (!SD_RxDataBlock(buff, 512)) break;
                buff += 512;
            } while (--count);
            SD_SendCmd(CMD12, 0);
        }
    }

    SD_Deselect();
    return count ? RES_ERROR : RES_OK;
}

#if _USE_WRITE == 1
DRESULT USER_write(BYTE pdrv, const BYTE *buff, DWORD sector, UINT count) {
    if (pdrv || !count) return RES_PARERR;
    if (Stat & STA_NOINIT) return RES_NOTRDY;
    if (Stat & STA_PROTECT) return RES_WRPRT;

    if (!(CardType & CT_BLOCK)) sector *= 512;

    if (count == 1) {
        if (SD_SendCmd(CMD24, sector) == 0 && SD_TxDataBlock(buff, 0xFE))
            count = 0;
    } else {
        if (CardType & CT_SDC) SD_SendCmd((0x80|CMD23), count);
        if (SD_SendCmd(CMD25, sector) == 0) {
            do {
                if (!SD_TxDataBlock(buff, 0xFC)) break;
                buff += 512;
            } while (--count);
            if (!SD_TxDataBlock(0, 0xFD)) count = 1;
        }
    }

    SD_Deselect();
    return count ? RES_ERROR : RES_OK;
}
#endif

#if _USE_IOCTL == 1
DRESULT USER_ioctl(BYTE pdrv, BYTE cmd, void *buff) {
    DRESULT res = RES_ERROR;
    BYTE n, csd[16];
    DWORD csize;

    if (pdrv) return RES_PARERR;
    if (Stat & STA_NOINIT) return RES_NOTRDY;

    switch (cmd) {
        case CTRL_SYNC:
            if (SD_Select()) {
                SD_Deselect();
                res = RES_OK;
            }
            break;

        case GET_SECTOR_COUNT:
            if ((SD_SendCmd(CMD9, 0) == 0) && SD_RxDataBlock(csd, 16)) {
                if ((csd[0] >> 6) == 1) {
                    /* SDv2 */
                    csize = csd[9] + ((WORD)csd[8] << 8)
                          + ((DWORD)(csd[7] & 63) << 16) + 1;
                    *(DWORD*)buff = csize << 10;
                } else {
                    /* SDv1 / MMC */
                    n = (csd[5] & 15) + ((csd[10] & 128) >> 7)
                      + ((csd[9] & 3) << 1) + 2;
                    csize = (csd[8] >> 6) + ((WORD)csd[7] << 2)
                          + ((WORD)(csd[6] & 3) << 10) + 1;
                    *(DWORD*)buff = csize << (n - 9);
                }
                res = RES_OK;
            }
            break;

        case GET_SECTOR_SIZE:
            *(WORD*)buff = 512;
            res = RES_OK;
            break;

        case GET_BLOCK_SIZE:
            *(DWORD*)buff = 512;
            res = RES_OK;
            break;

        default:
            res = RES_PARERR;
    }

    SD_Deselect();
    return res;
}
#endif
