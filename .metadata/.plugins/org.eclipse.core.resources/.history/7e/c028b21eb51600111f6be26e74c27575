#include "stm32l476xx.h"
#include "rcc.h"
#include "gpio.h"
#include "uart.h"
#include "spi.h"
#include "sdcard.h"
#include "ff.h"
#include <stdio.h>
#include <string.h>

FATFS fs;
FIL file;
UINT bw;

int main(void)
{
    RCC_Init();
    GPIO_Init();
    UART2_Init();
    SPI1_Init();

    UART2_Print("Starting...\r\n");

    /* Mount SD */
    if(f_mount(&fs, "", 1) != FR_OK)
    {
        UART2_Print("Mount Failed\r\n");
        while(1);
    }

    UART2_Print("Mount OK\r\n");

    /* Create & Write File */
    if(f_open(&file, "test.txt", FA_CREATE_ALWAYS | FA_WRITE) == FR_OK)
    {
        char data[] = "Hello from STM32!\r\n";

        f_write(&file, data, strlen(data), &bw);
        f_close(&file);

        UART2_Print("File Written Successfully\r\n");
    }
    else
    {
        UART2_Print("File Open Failed\r\n");
    }

    while(1);
}
