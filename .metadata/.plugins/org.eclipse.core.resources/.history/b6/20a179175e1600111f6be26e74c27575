#include "stm32l476xx.h"
#include "spi.h"
#include "uart.h"
#include "sdcard.h"
#include "ff.h"
#include "bme280.h"
#include "rtc.h"
#include "gpio.h"
#include "rcc.h"
#include <stdio.h>
#include <string.h>

FATFS fs;
FIL file;
UINT bw, br;

char buffer[256];

void delay_ms(uint32_t ms)
{
    for(uint32_t i = 0; i < ms * 4000; i++);
}

int main(void)
{
    RCC_Init();
    GPIO_Init();
    UART2_Init();

    UART2_Print("1. UART OK\r\n");

    SPI1_Init();
    UART2_Print("2. SPI OK\r\n");

    RTC_Init();
    UART2_Print("3. RTC OK\r\n");

    BME280_Init();
    UART2_Print("4. BME280 OK\r\n");

    if(f_mount(&fs, "", 1) == FR_OK)
        UART2_Print("5. SD Mounted OK\r\n");
    else
        UART2_Print("5. SD Mount FAILED\r\n");

    while(1);
}
